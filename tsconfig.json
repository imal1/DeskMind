{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["src"],
  // The tests run under `bun test`, which brings its own globals; typechecking
  // them here would mean pulling bun's type package in just to see them.
  "exclude": ["src/**/*.test.ts"]
}
